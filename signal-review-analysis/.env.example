# Copy to .env for Docker --env-file. Python does not automatically load this file.
REVIEW_BASE_URL=https://your-model-provider.example/v1
REVIEW_MODEL=your-structured-output-model
REVIEW_API_KEY=replace-with-your-provider-key
APP_ACCESS_TOKEN=replace-with-a-random-token-at-least-24-characters
PORT=8000
# Only for a specifically trusted non-HTTPS model endpoint:
# ALLOW_HTTP_MODEL=1
