<main id="main"><div class="topbar"><div>REVIEW ANALYSIS <span aria-hidden="true"> / </span> <strong>Gift Cards</strong></div><div class="view-switch" role="group" aria-label="Dashboard view"><button id="customerViewBtn" aria-pressed="true">Overview</button><button id="analystViewBtn" aria-pressed="false">Validation</button></div></div><div class="runbar"><div class="segmented" role="group" aria-label="Classification mode"><button id="binaryBtn" aria-pressed="true">Binary · Positive / Negative</button><button id="threeBtn" aria-pressed="false">Three-class · Include neutral</button></div><label class="sample-select">Sample<select id="sampleDesign"><option value="reference">Reference samples</option><option value="binary">First 100 rows</option><option value="three_class">Stratified 150</option></select></label><div class="run-note" id="runNote"></div></div><section id="overview"><div class="hero"><div><div class="eyebrow">Gift Cards</div><h1>Review classifications</h1></div></div><div class="scope-line"><span id="customerScope"></span><button class="text-button" id="scopeDetails">Sample details</button></div><div class="kpis customer-kpis" id="customerKpis"></div><article class="card quality-card" aria-labelledby="qualityTitle"><div class="quality-top"><h2 id="qualityTitle">Classification quality</h2><button class="text-button" id="qualityDetails">View validation</button></div><div class="quality-grid"><div><span class="sub">Matches the rating</span><strong id="qualityAccuracy"></strong><span class="sub" id="qualityCount"></span></div><div><span class="sub">Always choosing the largest class</span><strong id="qualityBaseline"></strong><span class="sub">Comparison baseline</span></div><div><p class="sub" style="margin-bottom:8px">Correct within each rating class</p><div class="quality-classes" id="qualityClasses"></div></div></div><p class="quality-note" id="qualityMistakes"></p><p class="sub">Ratings are used for evaluation only; the classifier receives review text.</p></article><div class="customer-grid"><article class="card sentiment-card"><div class="card-head"><div><h2>Sentiment</h2><p class="sub">Classified review counts</p></div></div><div id="sentimentStack" class="sentiment-stack" aria-label="Share of predicted sentiments"></div><div id="sentimentLegend" class="sentiment-legend"></div><div class="divider"></div><div class="next-step"><div><h3 id="attentionTitle"></h3></div><button class="button primary" id="negativeReviews">Filter negative</button></div></article><article class="card"><div class="card-head"><div><h2>Emotions</h2><p class="sub">Top five detected emotions</p></div></div><div id="customerEmotions"></div><p class="sub" id="customerEmotionNote" style="margin-top:20px"></p></article></div></section>
<div id="analystView" hidden><section id="validation"><div class="hero"><div><div class="eyebrow">Analysis</div><h1>Validation</h1></div></div>
<div class="kpis"><article class="card"><div class="kpi-label">Rating agreement <span>ACCURACY</span></div><div class="kpi-value accent" id="accuracy"></div><div class="kpi-foot" id="accuracyFoot"></div><div class="kpi-foot" id="accuracyInterval" style="margin-top:8px"></div></article><article class="card"><div class="kpi-label">Balanced accuracy</div><div class="kpi-value" id="balanced"></div><div class="kpi-foot">Equal weight to each class’s recall</div></article><article class="card"><div class="kpi-label">Macro F1</div><div class="kpi-value" id="f1"></div><div class="kpi-foot">Mean class F1 · scale 0–1</div></article><article class="card"><div class="kpi-label">Majority-class baseline</div><div class="kpi-value" id="baseline"></div><div class="kpi-foot" id="baselineFoot"></div></article></div><div class="insight" id="insight"></div>
<div class="grid"><article class="card"><div class="card-head"><div><h2>Classification results</h2><p class="sub">Click a cell to inspect its reviews.</p></div><span class="small-label">Confusion matrix</span></div><div class="matrix-caption">PREDICTED SENTIMENT →</div><div class="matrix-wrap"><div class="vertical-label">RATING-DERIVED CLASS →</div><table class="matrix" id="matrix" aria-label="Confusion matrix; rows are rating-derived classes and columns predictions"></table></div><div class="matrix-note"><span><i class="legend-mark"></i>Agreement</span><span><i class="legend-mark err"></i>Mismatch</span><span>Cell % = share of actual class</span></div></article>
<article class="card"><div class="card-head"><div><h2>Rating distribution</h2><p class="sub" id="distributionSub"></p></div><button class="text-button" id="distributionToggle">View full dataset</button></div><div id="distribution"></div><div class="divider"></div><div class="mini-head"><h3>Recall by class</h3><span class="small-label">Correct / actual</span></div><div id="recall"></div></article></div></section><section class="section" id="comparison"><div class="section-title"><div><div class="section-id">02 / EXPERIMENT DESIGN</div><h2>Experiment comparison</h2><p class="sub">The original reference runs are marked. Supplementary runs complete the same-input comparison.</p></div></div><article class="card"><div class="comparison-grid" id="comparisonGrid"></div><div class="insight" id="comparisonFinding"></div><p class="sub" style="margin-top:18px">The stratified sample is balanced across three rating classes (50 / 50 / 50). Binary scoring merges 3-star reviews with negatives, producing 50 positives and 100 negatives. Each run uses its own rating mapping and majority baseline.</p><details class="method-details"><summary>Prediction changes by sample</summary><div class="mini-head" style="margin-top:20px"><h3>Same reviews, independent predictions</h3><label class="sample-select">Sample<select id="pairSample"><option value="balanced150">Stratified 150</option><option value="first100">First 100</option></select></label></div><div id="pairedSummary" class="insight"></div><div style="overflow-x:auto"><table id="pairedMatrix" class="metric-table"></table></div><p class="sub" style="margin-top:15px">Rows are binary predictions; columns are three-class predictions. These are transitions between predictions, not a confusion matrix against ratings. Prompts and settings are frozen; requests share no answers or conversation. Calls were made at different times against the same named model, so this is a controlled descriptive comparison, not proof of a causal effect.</p></details></article></section>
<section class="section" id="emotions"><div class="section-title"><div><div class="section-id">04 / EMOTION ANALYSIS</div><h2>Emotion comparison</h2><p class="sub">Agreement between methods, not emotion accuracy: no human emotion labels are available.</p></div></div><div class="emotions-grid"><article class="card"><h2>Model and NRC labels</h2><div class="emotion-metrics"><div><strong class="accent" id="emotionAgree"></strong><span id="emotionAgreeFoot"></span></div><div><strong id="nrcTies"></strong><span>NRC maximum-score ties</span></div><div><strong id="nrcNone"></strong><span>Reviews with no NRC signal</span></div></div><div class="matrix-note"><span><i class="legend-mark"></i>Language model</span><span><i class="legend-mark" style="background:#90a5bb"></i>NRC word list</span><span>Review counts</span></div><div id="emotionBars"></div><div class="divider"></div><h3>Tie sensitivity</h3><div id="tieSensitivity"></div></article><article class="card"><div class="card-head"><div><h2>Disagreement examples</h2><p class="sub">Selected deterministically from this run’s disagreements.</p></div></div><div id="emotionExamples" class="examples"></div><div class="divider"></div><p class="sub" id="signalAgreement"></p><p class="sub" style="margin-top:12px">NRC counts word occurrences across eight emotions. Ties use alphabetical order; all tied labels remain visible in review details. No matched emotion words produces “none.” Negation and sarcasm are not modeled by this baseline.</p></article></div></section>
<section class="section" id="method"><div class="section-title"><div><div class="section-id">05 / METHOD & EVIDENCE</div><h2>Method and sources</h2><div class="theme-wrap"><label for="accentPicker">Interface accent</label><input id="accentPicker" type="color" value="#9befb1" aria-label="Choose dashboard accent color"></div></div><button class="button" id="downloadJSON">Download run JSON</button></div><article class="card"><div class="method-grid"><div><div class="number">REQUESTS</div><h3>No shared conversation</h3><p>Binary and three-class runs use separate prompts. Each request contains a system prompt plus one review’s title and text. No earlier answers or examples from the other run are included.</p></div><div><div class="number">INPUT FIELDS</div><h3>Rating exclusion</h3><p>Rating metadata never enters the model request. Explicit star-rating phrases in the title and body are masked. The original text, masked input, and model response are preserved for auditing.</p></div><div><div class="number">REPRODUCIBILITY</div><h3>Fixed samples, saved responses</h3><p id="methodSampling"></p></div></div><div class="divider"></div><footer><div>SIGNAL / REFERENCE ANALYSIS · Saved experiment, no live API calls<br><a href="https://amazon-reviews-2023.github.io/" target="_blank" rel="noreferrer">Amazon Reviews ’23 · McAuley Lab</a></div><div>Uses the NRC Word-Emotion Association Lexicon<br>Saif M. Mohammad & Peter D. Turney · National Research Council Canada<br><a href="https://saifmohammad.com/WebPages/NRC-Emotion-Lexicon.htm" target="_blank" rel="noreferrer">Lexicon source and terms</a></div></footer><h3>Class-level evidence</h3><p class="sub">Precision = correct among predicted; recall = correct among actual. F1 balances both.</p><div style="overflow-x:auto"><table class="metric-table" id="classMetrics"></table></div><p id="uncertaintyNote" class="sub" style="margin-top:15px"></p><details class="method-details"><summary>Read the exact classification prompt</summary><pre id="promptText"></pre></details><details class="method-details"><summary>Inspect run settings and limitations</summary><pre id="settings"></pre><p>Star ratings are the evaluation benchmark, not independently annotated textual sentiment. A mismatch can reflect a classifier error, a text–rating inconsistency, or an ambiguous review. These two runs change both sampling and the label scheme, so differences cannot be attributed to balancing alone. Rating masking is a transparent regex heuristic, not a guarantee that every implicit rating clue is removed.</p><p>Temperature 0 and a fixed request seed improve repeatability; the shared inference server may still vary. Saved responses are the authoritative snapshot. The LLM emotion is generated in the same request as sentiment; NRC scoring is independent and receives neither LLM output nor rating metadata.</p></details></article></section>
</div><section class="section" id="explorer"><div class="section-title"><div><h2>Reviews</h2><p class="sub">Filters apply to this table. Overview totals stay unchanged.</p></div><button class="button" id="export">Export filtered CSV</button></div><article class="card"><div class="controls"><label>Search title or review<input id="search" type="search" placeholder="Search review text…"></label><label class="benchmark-only">Rating agreement<select id="outcome"><option value="all">All results</option><option value="correct">Correct</option><option value="mismatch">Mismatches only</option></select></label><label class="benchmark-only">Rating-derived class<select id="actual"></select></label><label>Sentiment<select id="predicted"></select></label><label>Emotion<select id="emotionFilter"><option value="all">All emotions</option></select></label></div><label class="benchmark-toggle"><input type="checkbox" id="showBenchmark"> Show rating comparison</label><div class="filter-info"><span id="liveCount" role="status" aria-live="polite"></span><button class="text-button" id="reset">Reset filters</button></div><div class="table-scroll"><table class="review-table"><thead><tr><th>Review</th><th class="benchmark-only">Rating label</th><th>Sentiment</th><th class="benchmark-only">Comparison</th><th>Emotion</th></tr></thead><tbody id="reviewRows"></tbody></table></div><div class="pagination"><span id="pageLabel"></span><div><button class="button" id="prev" aria-label="Previous review page">← Previous</button><button class="button" id="next" aria-label="Next review page">Next →</button></div></div></article></section>
<footer><span>SIGNAL · Gift Cards review snapshot</span><button class="text-button" id="aboutAnalysis">Sources and methodology</button></footer>
</main><dialog id="detail" aria-labelledby="detailTitle"><div class="dialog-top"><div><div class="eyebrow" id="detailId"></div><h2 id="detailTitle"></h2></div><button class="button" id="closeDetail" aria-label="Close review details">Close ×</button></div><div id="detailContent"></div></dialog>
<script id="snapshot" type="application/json">__SNAPSHOT__</script>
<script>
'use strict';
const DATA=JSON.parse(document.getElementById('snapshot').textContent);
const $=id=>document.getElementById(id), esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const pct=x=>(100*x).toFixed(1)+'%', title=s=>s.charAt(0).toUpperCase()+s.slice(1).toLowerCase(), fmt=n=>n.toLocaleString('en-US');
let analystView=false;
let mode='binary',sampleDesign='reference',page=0,fullDistribution=false,filtered=[],pageSize=10;
const runKey=()=>sampleDesign==='reference'?mode:(mode==='binary'?(sampleDesign==='binary'?'binary':'binary_balanced'):(sampleDesign==='binary'?'three_class_first100':'three_class'));
const run=()=>DATA.runs[runKey()];
const evaluation=()=>DATA.analysis.runs[runKey()];
const range=v=>pct(v.low)+'–'+pct(v.high);
const badge=s=>`<span class="badge ${esc(s)}">${title(s)}</span>`;
function setMode(next){mode=next;page=0;fullDistribution=false;$('binaryBtn').setAttribute('aria-pressed',mode==='binary');$('threeBtn').setAttribute('aria-pressed',mode==='three_class');for(const id of ['actual','predicted'])$(id).innerHTML='<option value="all">All classes</option>'+run().metrics.labels.map(c=>`<option value="${c}">${title(c)}</option>`).join('');$('emotionFilter').innerHTML='<option value="all">All emotions</option>'+Object.keys(run().emotion_metrics.llm_counts).sort().map(e=>`<option value="${e}">${e==='none'?'None detected':title(e)}</option>`).join('');resetFilters();render();}
function render(){const r=run(),m=r.metrics,e=r.emotion_metrics;
const ev=evaluation(),u=ev.uncertainty;
$('runNote').textContent=ev.role+' · '+ev.sample_name;
$('accuracyInterval').textContent=u.available?'95% interval: '+range(u.intervals.accuracy):'Ordered sample · no population interval';
$('accuracy').textContent=pct(m.accuracy);$('accuracyFoot').textContent=`${m.correct} of ${m.n} match · ${m.mismatches} mismatches`;$('balanced').textContent=pct(m.balanced_accuracy);$('f1').textContent=m.macro_f1.toFixed(3);$('baseline').textContent=pct(m.majority_baseline);$('baselineFoot').textContent='Always predict the most common actual class';
let weakest=m.labels.reduce((a,b)=>m.per_class[a].recall<=m.per_class[b].recall?a:b);
$('insight').innerHTML=mode==='binary'?`<b>BASELINE</b><span>${pct(m.majority_baseline)} agreement is achievable by choosing the majority class every time. The model’s ${pct(m.accuracy)} overall agreement needs to be read alongside its ${pct(m.per_class.NEGATIVE.recall)} negative-class recall.</span>`:`<b>LOWEST RECALL</b><span>${title(weakest)} has the lowest recall: ${m.per_class[weakest].correct}/${m.per_class[weakest].support} (${pct(m.per_class[weakest].recall)}). ${ev.sample_key==='three_class'?'Equal class sizes expose these errors.':'This ordered sample contains few minority-class reviews.'} Ratings are still an imperfect benchmark for textual sentiment.</span>`;
$('matrix').innerHTML='<thead><tr><th scope="col">Actual ↓</th>'+m.labels.map(c=>`<th scope="col">${title(c)}</th>`).join('')+'</tr></thead><tbody>'+m.labels.map((c,i)=>'<tr><th scope="row">'+title(c)+'</th>'+m.labels.map((p,j)=>{const n=m.matrix[i][j],fraction=n/m.per_class[c].support,color=i===j?'var(--accent-rgb)':'242,165,148';return `<td><button data-actual="${c}" data-predicted="${p}" style="background:rgba(${color},${n?.08+.28*fraction:.025});color:${i===j?'var(--accent)':'var(--negative)'}" aria-label="Actual ${title(c)}, predicted ${title(p)}: ${n} reviews">${n}<small>${pct(fraction)}</small></button></td>`}).join('')+'</tr>').join('')+'</tbody>';
$('matrix').querySelectorAll('button').forEach(b=>b.onclick=()=>{$('actual').value=b.dataset.actual;$('predicted').value=b.dataset.predicted;$('outcome').value='all';$('emotionFilter').value='all';$('search').value='';$('showBenchmark').checked=true;document.body.classList.add('show-benchmark');page=0;renderRows();$('explorer').scrollIntoView();});
renderDistribution();$('recall').innerHTML=m.labels.map(c=>`<div class="recall-row"><span>${title(c)}</span><div class="track"><div class="fill" style="width:${100*m.per_class[c].recall}%;background:${c==='POSITIVE'?'var(--accent)':c==='NEUTRAL'?'var(--neutral)':'var(--negative)'}"></div></div><span class="num">${m.per_class[c].correct}/${m.per_class[c].support}</span></div>`).join('');
$('emotionAgree').textContent=pct(e.agreement_rate);$('emotionAgreeFoot').textContent=`${e.agreement_count}/${m.n} same primary label`;$('nrcTies').textContent=e.ties;$('nrcNone').textContent=e.no_signal;
const emotions=['joy','trust','anticipation','surprise','sadness','anger','fear','disgust','none']; const max=Math.max(...Object.values(e.llm_counts),...Object.values(e.nrc_counts),1);
$('emotionBars').innerHTML=emotions.map(c=>{let a=e.llm_counts[c]||0,b=e.nrc_counts[c]||0;return `<div class="paired-row"><span>${title(c)}</span><div class="paired-tracks"><div class="track"><div class="fill" style="width:${a/max*100}%"></div></div><div class="track"><div class="fill second" style="width:${b/max*100}%"></div></div></div><span class="paired-nums">${a} / ${b}</span></div>`}).join('');
let disagreements=r.rows.filter(x=>!x.emotion_agrees);let examples=[];let seen=new Set();for(const x of disagreements){let pair=x.prediction.emotion+'/'+x.nrc.emotion;if(!seen.has(pair)){seen.add(pair);examples.push(x);}if(examples.length===3)break;}
$('emotionExamples').innerHTML=examples.length?examples.map(x=>`<div class="example"><small>LLM ${title(x.prediction.emotion)} → NRC ${title(x.nrc.emotion)}</small><p><button class="review-link" data-review="${x.id}">${esc(x.title||'(Untitled review)')}</button></p><p>${esc(x.prediction.reason)}</p><span class="review-id">${x.nrc.tied.length>1?'NRC tie: '+x.nrc.tied.map(title).join(', '):x.nrc.matched_tokens+' matched word occurrences'}</span></div>`).join(''):'<p class="sub">No primary-emotion disagreements in this run.</p>';
const sensitivity=ev.emotion_sensitivity;
$('tieSensitivity').innerHTML=`<div class="chart-row"><span>Exact</span><div class="track"><div class="fill" style="width:${100*(sensitivity.exact_signal_rate||0)}%"></div></div><span class="num" id="exactSignal">${sensitivity.exact_signal_count}/${sensitivity.signal_n}</span></div><div class="chart-row"><span>Top set</span><div class="track"><div class="fill" style="width:${100*(sensitivity.top_set_rate||0)}%"></div></div><span class="num" id="topSet">${sensitivity.top_set_count}/${sensitivity.signal_n}</span></div><p class="sub" id="tieExplanation">${sensitivity.tie_break_only_count} additional labels are compatible when any tied maximum is accepted. Both denominators exclude ${sensitivity.no_signal_n} no-signal reviews. Top-set compatibility is a relaxed agreement measure, not accuracy. ${sensitivity.unique_agreement_count}/${sensitivity.unique_n} agree when NRC has a unique maximum.</p>`;
$('signalAgreement').textContent=`Among the ${e.with_signal} reviews with NRC signal, agreement is ${e.signal_agreement_rate===null?'not defined':pct(e.signal_agreement_rate)} (${e.signal_agreement_count}/${e.with_signal}). Overall agreement includes “none” matches.`;
$('methodSampling').textContent=`The first experiment uses the first 100 rows. The balanced experiment samples 50 reviews per rating-derived class from all ${fmt(DATA.dataset.total)} rows, with seed 6418. Temperature 0; saved responses retain the exact output.`;
$('classMetrics').innerHTML='<thead><tr><th>Class</th><th>Actual</th><th>Predicted</th><th>Correct</th><th>Precision</th><th>Recall</th><th>95% recall interval</th><th>F1</th></tr></thead><tbody>'+m.labels.map(c=>{let p=m.per_class[c];return `<tr><td>${title(c)}</td><td>${p.support}</td><td>${p.predicted}</td><td>${p.correct}</td><td>${pct(p.precision)}</td><td>${pct(p.recall)}</td><td>${u.available?range(u.intervals[c+'.recall']):'Not inferred'}</td><td>${p.f1.toFixed(3)}</td></tr>`}).join('')+'</tbody>';
$('uncertaintyNote').textContent=u.available?'Approximate 95% stratified bootstrap intervals · 10,000 resamples · seed 6419. Resampling preserves the original 50/50/50 rating strata, including for binary scoring. Assumes independent reviews within strata. These describe sampling variability for this designed mixture—not full-corpus performance, label validity, or model-run variability. Percentile intervals can have limited small-sample coverage.':u.reason;
$('promptText').textContent=r.prompt;$('settings').textContent=JSON.stringify({created_utc:r.created_utc,...r.config,rating_mapping:mode==='binary'?'4–5 positive; 1–3 negative':'4–5 positive; 3 neutral; 1–2 negative',masked_reviews:m.masked_reviews,dataset_sha256:DATA.dataset.sha256,nrc:r.nrc_method,uncertainty:u},null,2);
renderRows();bindReviews();renderComparison();renderCustomer();}
function renderDistribution(){const counts=fullDistribution?DATA.dataset.ratings:run().rows.reduce((a,r)=>(a[r.rating]=(a[r.rating]||0)+1,a),{});const n=fullDistribution?DATA.dataset.total:run().metrics.n;const max=Math.max(...Object.values(counts),1);$('distributionSub').textContent=`${fullDistribution?'Full dataset':'Selected run'} · ${fmt(n)} reviews · star-rating counts${fullDistribution?' · '+pct(((counts[4]||0)+(counts[5]||0))/n)+' positive':''}`;$('distributionToggle').textContent=fullDistribution?'View selected run':'View full dataset';$('distribution').innerHTML=[5,4,3,2,1].map(star=>`<div class="chart-row"><span>${star} stars</span><div class="track"><div class="fill" style="width:${(counts[star]||0)/max*100}%;opacity:${.5+star*.1}"></div></div><span class="num">${fmt(counts[star]||0)}</span></div>`).join('');}
function resetFilters(){for(const id of ['actual','predicted','outcome','emotionFilter'])$(id).value='all';$('search').value='';page=0;renderRows();}
function renderRows(){let query=$('search').value.toLowerCase(),actual=$('actual').value,pred=$('predicted').value,outcome=$('outcome').value,emotion=$('emotionFilter').value;filtered=run().rows.filter(r=>(actual==='all'||r.actual===actual)&&(pred==='all'||r.prediction.sentiment===pred)&&(outcome==='all'||(r.actual===r.prediction.sentiment)===(outcome==='correct'))&&(emotion==='all'||r.prediction.emotion===emotion)&&(!query||(r.title+' '+r.text).toLowerCase().includes(query)));const pages=Math.max(1,Math.ceil(filtered.length/pageSize));page=Math.min(page,pages-1);$('liveCount').textContent=`${filtered.length} of ${run().metrics.n} reviews${$('showBenchmark').checked?' · '+filtered.filter(r=>r.actual!==r.prediction.sentiment).length+' rating mismatches in view':''}`;$('reviewRows').innerHTML=filtered.slice(page*pageSize,(page+1)*pageSize).map(r=>`<tr><td><button class="review-link" data-review="${r.id}">${esc(r.title||'(Untitled review)')}</button><p class="excerpt">${esc(r.text)}</p><span class="review-id">${r.id}</span></td><td class="benchmark-only">${badge(r.actual)}<p class="review-id">${r.rating} / 5 stars</p></td><td>${badge(r.prediction.sentiment)}</td><td class="benchmark-only ${r.actual===r.prediction.sentiment?'correct':'mismatch'}">${r.actual===r.prediction.sentiment?'✓ Correct':'↗ Mismatch'}</td><td>${r.prediction.emotion==='none'?'None detected':title(r.prediction.emotion)}</td></tr>`).join('')||'<tr><td colspan="5" class="empty">No reviews match these filters. Try resetting the filters.</td></tr>';$('pageLabel').textContent=filtered.length?`${page*pageSize+1}–${Math.min((page+1)*pageSize,filtered.length)} of ${filtered.length} · Page ${page+1}/${pages}`:'0 reviews';$('prev').disabled=page===0;$('next').disabled=page>=pages-1;bindReviews();}
function bindReviews(){document.querySelectorAll('[data-review]').forEach(b=>b.onclick=()=>showReview(b.dataset.review));}
function showReview(id){const r=run().rows.find(r=>r.id===id);$('detailId').textContent='REVIEW / '+id;$('detailTitle').textContent=r.title||'(Untitled review)';$('detailContent').innerHTML=`<p class="dialog-sub">${r.verified_purchase?'Verified purchase':'Not marked verified'} · ${r.helpful_vote||0} helpful votes</p><div class="full-text">${esc(r.text)}</div><div class="detail-grid"><div class="detail-box"><span class="small-label">Sentiment</span><p>${badge(r.prediction.sentiment)}</p><p>${esc(r.prediction.reason)}</p><p class="dialog-sub">Automated explanation</p></div><div class="detail-box"><span class="small-label">Emotion</span><p><strong>${r.prediction.emotion==='none'?'None detected':title(r.prediction.emotion)}</strong></p><p class="dialog-sub">Model classification.</p></div></div><details class="method-details"><summary>Rating comparison & technical evidence</summary><p>Original rating: ${r.rating}/5 · Rating-derived label: ${badge(r.actual)} · ${r.actual===r.prediction.sentiment?'Matches classification':'Differs from classification'}.</p><p>Source line ${r.source_line}. NRC emotion: ${title(r.nrc.emotion)}. Matched ${r.nrc.matched_tokens}/${r.nrc.total_tokens} word occurrences.${r.nrc.tied.length>1?' Tied maxima: '+r.nrc.tied.map(title).join(', ')+'.':''}</p><details><summary>Exact model input</summary><pre>${esc(JSON.stringify(r.model_input,null,2))}</pre></details><details><summary>NRC emotion scores</summary><pre>${esc(JSON.stringify(r.nrc.scores,null,2))}</pre></details><details><summary>Raw model response</summary><pre>${esc(JSON.stringify(r.response,null,2))}</pre></details></details>`;$('detail').showModal();}
function download(name,content,type){let url=URL.createObjectURL(new Blob([content],{type}));let a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}
$('sampleDesign').onchange=e=>{sampleDesign=e.target.value;setMode(mode);};$('pairSample').onchange=renderPair;
$('binaryBtn').onclick=()=>setMode('binary');$('threeBtn').onclick=()=>setMode('three_class');$('distributionToggle').onclick=()=>{fullDistribution=!fullDistribution;renderDistribution();};$('reset').onclick=resetFilters;for(const id of ['search','outcome','actual','predicted','emotionFilter'])$(id).addEventListener('input',()=>{page=0;renderRows();});$('prev').onclick=()=>{page--;renderRows();};$('next').onclick=()=>{page++;renderRows();};$('closeDetail').onclick=()=>$('detail').close();$('detail').onclick=e=>{if(e.target===$('detail')&&e.offsetX<0)$('detail').close();};
$('downloadJSON').onclick=()=>download('signal-'+runKey()+'.json',JSON.stringify(run(),null,2),'application/json');
$('export').onclick=()=>{let fields=['id','title','text','rating','actual','prediction','llm_emotion','nrc_emotion','correct'];let cell=x=>'"'+String(x??'').replace(/^[\s]*[=+@-]/,"'$&").replace(/"/g,'""')+'"';let lines=filtered.map(r=>[r.id,r.title,r.text,r.rating,r.actual,r.prediction.sentiment,r.prediction.emotion,r.nrc.emotion,r.actual===r.prediction.sentiment]);download('signal-'+runKey()+'-filtered.csv','\ufeff'+[fields,...lines].map(row=>row.map(cell).join(',')).join('\r\n'),'text/csv;charset=utf-8');};
$('accentPicker').oninput=e=>{let hex=e.target.value;document.documentElement.style.setProperty('--accent',hex);document.documentElement.style.setProperty('--accent-rgb',[1,3,5].map(i=>parseInt(hex.slice(i,i+2),16)).join(','));};
function renderComparison(){
 const groups=[['First 100 source rows',['binary','three_class_first100']],['Stratified 150 reviews',['binary_balanced','three_class']]];
 $('comparisonGrid').innerHTML=groups.map(([label,keys])=>`<div class="comparison-group"><h3>${label}</h3>${keys.map(key=>{const a=DATA.analysis.runs[key],m=a.metrics;return `<button class="experiment-card ${key===runKey()?'selected':''}" data-experiment="${key}" aria-label="Inspect ${a.mode==='binary'?'binary':'three-class'} on ${label}"><span class="small-label">${a.mode==='binary'?'BINARY':'THREE-CLASS'} · ${a.role.toUpperCase()}</span><strong>${pct(m.accuracy)}</strong><span>${m.correct}/${m.n} rating agreement</span><small>Baseline ${pct(m.majority_baseline)} · Macro F1 ${m.macro_f1.toFixed(3)}</small></button>`}).join('')}</div>`).join('');
 const first=DATA.runs.three_class_first100.metrics;const balanced=DATA.runs.three_class.metrics;
 $('comparisonFinding').textContent=`The three-class prompt reaches ${pct(first.accuracy)} on the first 100 reviews while identifying ${first.per_class.NEUTRAL.correct}/${first.per_class.NEUTRAL.support} neutrals. On the stratified sample it identifies ${balanced.per_class.NEUTRAL.correct}/${balanced.per_class.NEUTRAL.support}. Overall accuracy alone hides this weakness.`;
 $('comparisonGrid').querySelectorAll('[data-experiment]').forEach(b=>b.onclick=()=>{const a=DATA.analysis.runs[b.dataset.experiment];sampleDesign=a.sample_key;$('sampleDesign').value=sampleDesign;setMode(a.mode);$('validation').scrollIntoView();});renderPair();
}
function renderPair(){const p=DATA.analysis.paired[$('pairSample').value];$('pairedSummary').textContent=`${p.same_polarity}/${p.n} retain the same polarity; ${p.to_neutral} become neutral; ${p.opposite_polarity} switch between positive and negative.`;$('pairedMatrix').innerHTML='<thead><tr><th>Binary ↓ / Three-class →</th>'+p.column_labels.map(c=>'<th>'+title(c)+'</th>').join('')+'</tr></thead><tbody>'+p.row_labels.map((c,i)=>'<tr><th>'+title(c)+'</th>'+p.prediction_transitions[i].map(n=>'<td>'+n+'</td>').join('')+'</tr>').join('')+'</tbody>';}
function setView(advanced,target){analystView=advanced;if(!advanced){$('showBenchmark').checked=false;document.body.classList.remove('show-benchmark');$('actual').value='all';$('outcome').value='all';renderRows();}$('analystView').hidden=!advanced;$('overview').hidden=advanced;document.querySelectorAll('.analyst-nav').forEach(x=>x.hidden=!advanced);document.querySelectorAll('.customer-nav').forEach(x=>x.hidden=advanced);$('customerViewBtn').setAttribute('aria-pressed',!advanced);$('analystViewBtn').setAttribute('aria-pressed',advanced);$(target||(advanced?'validation':'overview')).scrollIntoView();syncNav();}
function filterSentiment(label){resetFilters();$('predicted').value=label;renderRows();$('explorer').scrollIntoView();}
function renderCustomer(){const r=run(),m=r.metrics;$('qualityAccuracy').textContent=pct(m.accuracy);$('qualityCount').textContent=`${m.correct} of ${m.n} reviews`;$('qualityBaseline').textContent=pct(m.majority_baseline);$('qualityClasses').innerHTML=m.labels.map(c=>`<span>${title(c)}<b>${m.per_class[c].correct} / ${m.per_class[c].support}</b></span>`).join('');const mistakes=[];m.labels.forEach((actual,i)=>m.labels.forEach((predicted,j)=>{if(i!==j&&m.matrix[i][j])mistakes.push({n:m.matrix[i][j],actual,predicted});}));mistakes.sort((a,b)=>b.n-a.n);$('qualityMistakes').textContent=mistakes.length?`${m.mismatches} mismatches. Most common: ${mistakes[0].n} rated ${title(mistakes[0].actual).toLowerCase()} classified as ${title(mistakes[0].predicted).toLowerCase()}.`:'All predictions match the rating labels in this sample.';const counts=Object.fromEntries(m.labels.map(c=>[c,m.per_class[c].predicted]));$('customerScope').textContent=`${fmt(m.n)} reviews · ${mode==='binary'?'Binary':'Three-class'} · Selected sample, not a population estimate.`;
const cards=[['all','Reviews',m.n,'Selected sample'],...m.labels.map(c=>[c,title(c)+' reviews',counts[c],pct(counts[c]/m.n)+' of sample'])];$('customerKpis').innerHTML=cards.map(([label,name,n,note])=>`<button class="card customer-kpi" data-sentiment="${label}"><span class="kpi-label">${name}</span><span class="kpi-value ${label==='NEGATIVE'?'negative-number':label==='NEUTRAL'?'neutral-number':'accent'}">${n}</span><span class="kpi-foot">${note}</span></button>`).join('');
const color=c=>c==='POSITIVE'?'var(--accent)':c==='NEUTRAL'?'var(--neutral)':'var(--negative)';$('sentimentStack').innerHTML=m.labels.map(c=>`<button data-sentiment="${c}" aria-label="${title(c)}: ${counts[c]} reviews" style="width:${100*counts[c]/m.n}%;background:${color(c)}" ${counts[c]===0?'hidden':''}></button>`).join('');$('sentimentLegend').innerHTML=m.labels.map(c=>`<button data-sentiment="${c}"><i style="background:${color(c)}"></i><span>${title(c)}</span><strong>${pct(counts[c]/m.n)}</strong></button>`).join('');$('attentionTitle').textContent=`${counts.NEGATIVE||0} negative reviews`;
const emotions=Object.entries(r.emotion_metrics.llm_counts).filter(([e])=>e!=='none').sort((a,b)=>b[1]-a[1]||a[0].localeCompare(b[0])).slice(0,5);$('customerEmotions').innerHTML=emotions.map(([e,n])=>`<button class="customer-emotion" data-emotion="${e}"><span>${title(e)}</span><span class="track"><span class="fill" style="display:block;width:${100*n/m.n}%"></span></span><strong>${n}</strong></button>`).join('');$('customerEmotionNote').textContent=`No emotion detected: ${r.emotion_metrics.llm_counts.none||0} reviews.`;
document.querySelectorAll('[data-sentiment]').forEach(b=>b.onclick=()=>filterSentiment(b.dataset.sentiment));document.querySelectorAll('[data-emotion]').forEach(b=>b.onclick=()=>{resetFilters();$('emotionFilter').value=b.dataset.emotion;renderRows();$('explorer').scrollIntoView();});}
$('customerViewBtn').onclick=()=>setView(false);$('analystViewBtn').onclick=()=>setView(true);$('scopeDetails').onclick=()=>setView(true,'method');$('aboutAnalysis').onclick=()=>setView(true,'method');$('negativeReviews').onclick=()=>filterSentiment('NEGATIVE');$('showBenchmark').onchange=e=>{document.body.classList.toggle('show-benchmark',e.target.checked);if(!e.target.checked){$('actual').value='all';$('outcome').value='all';}page=0;renderRows();};
$('uploadReviews').onclick=()=>{if(document.querySelector('meta[name="signal-workspace"]')?.content==='connected'){location.assign('/upload.html');return;}$('detailTitle').textContent='Upload reviews';$('detailContent').innerHTML='<p>This preview contains the reference results. Upload classification runs in the Python workspace.</p><p>Download and extract <strong>Signal_Review_Intelligence_Project.zip</strong>. Follow <strong>docs/DEPLOYMENT.md</strong> to configure the model connection and workspace token, run <code>python server.py</code>, then open <code>http://localhost:8000</code>.</p><p>On the deployed app, this button opens the upload workspace directly.</p>';$('detail').showModal();};
$('qualityDetails').onclick=()=>setView(true);
setMode('binary');
function syncNav(){let active=analystView?'validation':'overview';for(const id of (analystView?['validation','comparison','emotions','method','explorer']:['overview','explorer']))if($(id).getBoundingClientRect().top<200)active=id;document.querySelectorAll('.nav a').forEach(a=>{let selected=a.hash==='#'+active;a.classList.toggle('active',selected);if(selected)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');});}
window.addEventListener('scroll',syncNav,{passive:true});syncNav();
</script></body></html>
